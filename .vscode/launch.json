{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: financial_chunker",
      "type": "debugpy",
      "request": "launch",
      "module": "app.phase2.financial_chunker",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug: hybrid_retriever",
      "type": "debugpy",
      "request": "launch",
      "module": "app.phase2.hybrid_retriever",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug: FastAPI server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}